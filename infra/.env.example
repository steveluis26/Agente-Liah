# infra/.env — EJEMPLO para producción. Copia a infra/.env y edita.
# NUNCA se commitea el .env real (está en .gitignore).

# ── Base de datos (servicio "postgres" del compose) ──────────────────────
POSTGRES_USER=pyme
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_LARGA_Y_ALEATORIA
POSTGRES_DB=pyme_agent
DATABASE_URL=postgresql+asyncpg://pyme:CAMBIA_ESTA_PASSWORD_LARGA_Y_ALEATORIA@postgres:5432/pyme_agent
REDIS_URL=redis://redis:6379/0

# Puerto público de la API (detrás de nginx/traefik con TLS en producción)
API_PORT=8000

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO

# ── Panel (JWT HS256) ────────────────────────────────────────────────────
LIAH_JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_LARGO_Y_ALEATORIO
LIAH_JWT_EXPIRE_MINUTES=480

# ── WhatsApp / Meta ──────────────────────────────────────────────────────
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=CAMBIA_O_DEJA_VACIO_HASTA_EMBEDDED_SIGNUP
WHATSAPP_VERIFY_TOKEN=un-token-largo-que-inventes-para-el-webhook
WHATSAPP_VERIFY_SIGNATURE=true

# ── Seguridad / hardening (Fase 8) ───────────────────────────────────────
LIAH_CORS_ORIGINS=
LIAH_RATE_LIMIT_ENABLED=true
LIAH_LOG_JSON=true
LIAH_API_KEY_PEPPER=CAMBIA_ESTE_PEPPER_LARGO_Y_ALEATORIO

# ── Envíos ───────────────────────────────────────────────────────────────
# 1 = DRY RUN (no se envía nada a Meta; los mensajes quedan encolados y
# visibles en logs/panel). Ponlo en 0 SOLO con plantillas HSM aprobadas
# y el número de WhatsApp Business verificado.
LIAH_SEND_DRY_RUN=1

# ── Campañas ─────────────────────────────────────────────────────────────
LIAH_CAMPAIGN_RATE_PER_SEC=1.0
LIAH_CAMPAIGN_COST_USD=0.06

# ── OpenAI (solo para modo renta; en compra única cada cliente pone la suya)
OPENAI_API_KEY=
