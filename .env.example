# ── App ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me

# ── Postgres (pgvector) ──────────────────────────────
# Valores por defecto compatibles con infra/docker-compose.yml
POSTGRES_USER=pyme
POSTGRES_PASSWORD=pyme
POSTGRES_DB=pyme_agent
DATABASE_URL=postgresql+asyncpg://pyme:pyme@localhost:5432/pyme_agent
# BD de la suite de tests (drop_all/create_all por test; NUNCA la de demo ni prod).
TEST_DATABASE_URL=postgresql+asyncpg://pyme:pyme@localhost:5432/pyme_agent_test

# ── Redis (Fase 2: reminder engine) ─────────────────
REDIS_URL=redis://localhost:6379/0

# ── Meta WhatsApp Cloud API ─────────────────────────
WHATSAPP_APP_ID=
# Clave de la app de Meta (secreto). Úsala para validar la firma del webhook.
WHATSAPP_APP_SECRET=test_app_secret
# Token que Meta envía en el GET de verificación (debe coincidir con el configurado en Meta).
WHATSAPP_VERIFY_TOKEN=test_token_123
# En true exige X-Hub-Signature-256 en cada POST. Pon false SOLO en sandbox/dev.
WHATSAPP_VERIFY_SIGNATURE=true

# ── Vault de secretos (producción) ──────────────────
# En Fase 0 los tokens viven en env; en prod resuelve token_secret_ref vía tu secret manager.

# ── Panel de operador (Fase 3) ───────────────────────
# Secreto HS256 para los JWT del panel. OBLIGATORIO en producción: si sigue
# siendo el default, la app no arranca con APP_ENV=production.
LIAH_JWT_SECRET=change-me
# Expiración del JWT en minutos (default 480 = 8h, una jornada de operador).
LIAH_JWT_EXPIRE_MINUTES=480
# Password del primer platform_admin (solo la usa scripts/seed_platform_admin.py;
# también acepta prompt interactivo). Nunca la dejes en un .env commiteado.
LIAH_ADMIN_PASSWORD=
# Pepper para el hash de API keys por tenant (obligatorio en producción).
LIAH_API_KEY_PEPPER=

# ── LLM / embeddings por tenant (Fase 2) ─────────────
# API key de OpenAI global (fallback). En producción cada tenant usa la suya:
# OPENAI_API_KEY_TENANT_<SLUG> (slug en mayúsculas, no alfanuméricos -> _).
OPENAI_API_KEY=
# Tabla referencial de precios por modelo (JSON) para el costeo por turno.
LIAH_MODEL_PRICES_JSON=
# Dimensión canónica de embeddings. ÚNICA fuente de verdad: debe coincidir
# con la columna pgvector (1536 = OpenAI text-embedding-3-small; 768 = Ollama
# nomic-embed-text). Fijarla ANTES de crear el esquema.
EMBED_DIM=1536
# Defaults del factory por tenant (cada tenant puede sobreescribir en
# tenant_configs.model_routing).
LIAH_DEFAULT_LLM_PROVIDER=openai
LIAH_DEFAULT_LLM_MODEL=gpt-4o-mini
LIAH_DEFAULT_LLM_TEMPERATURE=0.2
LIAH_DEFAULT_EMBEDDER=fake
# Token de WhatsApp por canal: WA_TOKEN_<secret_ref> (ver token_secret_ref).
# En producción, resolver vía secret manager (stub VaultSecretProvider).

# ── Ollama (dev local, costo 0) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_EMBED_DIM=

# ── Envíos y scheduler (Fase 5) ──────────────────────
# "1" = dry-run: los envíos se registran pero NO llaman a Meta. Pon "0" solo
# con token real configurado.
LIAH_SEND_DRY_RUN=1
# Scheduler de recordatorios in-process (dev, app/main.py). En producción usa
# el worker dedicado (python -m app.worker) con ENABLE_REMINDER_SCHEDULER=false.
ENABLE_REMINDER_SCHEDULER=false
# Worker de fondo (app/worker.py): intervalos en segundos y tope por drenado.
WORKER_DRAIN_INTERVAL_S=10
WORKER_REMINDER_INTERVAL_S=3600
WORKER_DRAIN_LIMIT=50

# ── Demo end-to-end (Fase 5) ─────────────────────────
# BD propia de la demo (se crea si no existe; nunca es la de test).
LIAH_DEMO_DATABASE_URL=postgresql+asyncpg://pyme:pyme@localhost:5432/pyme_agent_demo
# =1 permite a scripts/demo_consultorio.py --reset hacer drop_all. Por
# default la demo NO borra nada.
LIAH_DEMO_RESET=0
# Password del tenant_admin creado por scripts/onboard_tenant.py
# (o prompt interactivo si se omite). Nunca commitear un valor real.
LIAH_TENANT_ADMIN_PASSWORD=
